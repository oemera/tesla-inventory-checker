POLL_INTERVAL_SECONDS=60
INVENTORY_PROVIDER=browser
SCRAPER_URL=http://scraper:8080
SESSION_MAX_AGE_SECONDS=1800
# Required: true is rejected. Compose supplies the reviewed seccomp profile.
BROWSER_NO_SANDBOX=false
TECHNICAL_ALERTS=false
# After publishing, set both images to the same explicit GHCR release tag.
WATCHER_IMAGE=tesla-inventory-checker:0.3.0
SCRAPER_IMAGE=tesla-inventory-checker-scraper:0.3.0
CONFIG_PATH=/app/config/profiles.json
STATE_PATH=/app/state/watcher.sqlite
NOTIFY_ON_FIRST_SEEN=false
HEALTH_MAX_AGE_SECONDS=180
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
